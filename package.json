{
	"name": "keyshift",
	"version": "1.1.0",
	"description": "Fix text typed with the wrong Windows keyboard layout using a global shortcut.",
	"author": {
		"name": "Mohadese Ghadimi",
		"url": "https://github.com/mohadesegh"
	},
	"homepage": "https://github.com/mohadesegh/keyshift#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohadesegh/keyshift.git"
	},
	"bugs": {
		"url": "https://github.com/mohadesegh/keyshift/issues"
	},
	"type": "commonjs",
	"main": "./dist/cli.js",
	"bin": {
		"keyshift": "./dist/cli.js"
	},
	"files": [
		"dist",
		"native/keyshift-host.exe",
		"native/KeyShiftHost.cs",
		"scripts/build-host.js",
		"scripts/build-host.ps1",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"build:ts": "tsc",
		"build:host": "node ./scripts/build-host.js",
		"build": "npm run clean && npm run build:ts && npm run build:host",
		"prepack": "npm run build",
		"start": "node ./dist/cli.js start",
		"stop": "node ./dist/cli.js stop"
	},
	"keywords": [
		"keyboard-layout",
		"layout-switcher",
		"wrong-keyboard-layout",
		"persian-keyboard",
		"farsi-keyboard",
		"windows",
		"global-hotkey",
		"keyboard-converter",
		"qwerty",
		"azerty",
		"qwertz"
	],
	"engines": {
		"node": ">=18"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "^5.8.0"
	}
}
