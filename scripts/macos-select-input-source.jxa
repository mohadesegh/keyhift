ObjC.import("Carbon");

function property(source, key) {
  const value = $.TISGetInputSourceProperty(source, key);
  return value ? ObjC.deepUnwrap(value) : null;
}

function run(argv) {
  const requestedLayout = String(argv[0] || "").toLowerCase();
  const wantedLanguage = requestedLayout === "fa-ir" ? "fa" : "en";
  const preferredIds = requestedLayout === "fa-ir"
    ? ["com.apple.keylayout.Persian", "com.apple.inputmethod.Persian"]
    : ["com.apple.keylayout.US", "com.apple.keylayout.ABC"];
  const sources = $.TISCreateInputSourceList(null, false);
  const count = $.CFArrayGetCount(sources);
  let languageMatch = null;

  for (let index = 0; index < count; index += 1) {
    const source = $.CFArrayGetValueAtIndex(sources, index);
    const selectable = Boolean(property(
      source,
      $.kTISPropertyInputSourceIsSelectCapable,
    ));

    if (!selectable) {
      continue;
    }

    const sourceId = String(property(
      source,
      $.kTISPropertyInputSourceID,
    ) || "");
    const languageValue = property(
      source,
      $.kTISPropertyInputSourceLanguages,
    );
    const languages = Array.isArray(languageValue)
      ? languageValue
      : languageValue ? [languageValue] : [];

    if (preferredIds.includes(sourceId)) {
      const status = $.TISSelectInputSource(source);
      $.CFRelease(sources);
      return status === 0 ? sourceId : `error:${status}`;
    }

    if (!languageMatch && languages.some((language) =>
      String(language).toLowerCase().startsWith(wantedLanguage)
    )) {
      languageMatch = source;
    }
  }

  if (languageMatch) {
    const status = $.TISSelectInputSource(languageMatch);
    $.CFRelease(sources);
    return status === 0 ? wantedLanguage : `error:${status}`;
  }

  $.CFRelease(sources);
  throw new Error(`No selectable ${requestedLayout} input source is installed.`);
}
